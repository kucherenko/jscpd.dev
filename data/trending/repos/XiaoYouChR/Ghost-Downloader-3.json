       "def parseTimeInput(text: str) -> int:",
       "    text = text.strip()",
       "    if not text:",
       "        return 0",
       "    parts = text.split(\":\")",
       "    try:",
       "        if len(parts) == 2:",
       "            return int(parts[0]) * 60 + int(parts[1])",
       "        if len(parts) == 3:",
       "            return int(parts[0]) * 3600 + int(parts[1]) * 60 + int(parts[2])"
      ],
      "total": 20
